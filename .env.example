# ==========================================
# Watchdog — shared env for local dev
# Copy to .env and fill in. Loaded by all apps.
# ==========================================

NODE_ENV=development

# ---------- Database ----------
# Primary (writes). Matches docker-compose.yml.
DATABASE_URL=postgres://monitor_user:monitor_password@localhost:5433/monitoreo_recursos
# Read replica. Use for read-only queries.
DATABASE_READ_URL=postgres://monitor_user:monitor_password@localhost:5434/monitoreo_recursos

# ---------- Redis / BullMQ ----------
REDIS_URL=redis://localhost:6379

# ---------- API (Fastify) ----------
API_PORT=3001
API_HOST=0.0.0.0
# Server-to-server URL other services use to reach the API (e.g. web's health check).
# Different from NEXT_PUBLIC_API_URL below in prod, where this may be an internal
# Docker network hostname instead of the public-facing URL the browser uses.
API_URL=http://localhost:3001

# ---------- Web (Next.js) ----------
# URL the web app calls for the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Auth ----------
# Generate with: npx auth secret
AUTH_SECRET=

# ---------- Agent (Go) ----------
# Where the agent POSTs metrics
AGENT_API_URL=http://localhost:3001
AGENT_SAMPLE_INTERVAL=5s

# ---------- Linear sync (solo para scripts/linear-sync.ts) ----------
# Personal API key: https://linear.app/settings/api
LINEAR_API_KEY=


WORKER_SHUTDOWN_TIMEOUT=30000  # ms to wait before forcing shutdown

# Tamaño màximo del buffer del worker en bytes antes de hacer el flush
# Default: 10 MB (10 * 1024 * 1024 = 10485760)
# Ejemplos:
#   5MB  → 5242880
#   10MB → 10485760
#   20MB → 20971520

WORKER_BUFFER_MAX_BYTES=10485760
# Maximun number of MetricsContainer the agent buffer can hold before dropping oldest entries
# Default: 300 (approx. 10 minutes od data at container every 2 seconds)
# Examples:
#   5 min  → 150
#   10 min → 300
#   20 min → 600
AGENT_BUFFER_MAX_CONTAINERS=300
# Maximum time to wait for each collector to gather its metric before cancelling
# Default: 3s — must be lower than AGENT_SAMPLE_INTERVAL (5s) to leave margin between ticks
# Examples:
#   2s → faster timeout, less wait
#   3s → default, 2s margin before next tick
#   4s → slower timeout, less margin
AGENT_COLLECT_TIMEOUT=3s
# How often the agent reads from the buffer and publishes data to the server
# Default: 5s
# Examples: 
#   5s → publishes every 5 seconds (recoommended for real-time monitoring)
#  10s → publishes every 10 seconds (lees frequent, lower server load)
#  30s → publishes every 30 seconds (batch mode)
AGENT_PUBLISH_INTERVAL=5s
# Maximum number of collection cycles the agent sends to the server per publish
# Each cycle contains 4 metrics (CPU, RAM, Disk, Network)
# Default: 50 cycles = 200 metrics per publish (~4 minutes of data at 5s interval)
# Examples:
#   25  → 100 metrics per publish (~2 min of data)
#   50  → 200 metrics per publish (~4 min of data)
#   100 → 400 metrics per publish (~8 min of data)
AGENT_SERVER_MAX_CYCLES=50
# Google OAuth credentials — see docs/operations/google-oauth-setup.md
AUTH_GOOGLE_ID=tu_client_id_aqui
AUTH_GOOGLE_SECRET=tu_client_secret_aqui